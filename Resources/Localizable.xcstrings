    "The Home card displays only this image and does not open when tapped. Long press it for options.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Home card displays only this image and does not open when tapped. Long press it for options."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta na úvodní stránce zobrazuje pouze obrázek a klepnutím se neotevře. Podržením zobrazíte možnosti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte auf Start zeigt nur dieses Bild und öffnet sich beim Tippen nicht. Für Optionen gedrückt halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte d’accueil affiche uniquement cette image et ne s’ouvre pas au toucher. Maintenez-la pour afficher les options."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Картата в Начало показва само това изображение и не се отваря при докосване. Задръжте за опции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta na úvodnej stránke zobrazuje iba tento obrázok a po klepnutí sa neotvorí. Podržaním zobrazíte možnosti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte d’accueil affiche uniquement cette image et ne s’ouvre pas au toucher. Maintenez-la pour afficher les options."
          }
        }
      }
    },
