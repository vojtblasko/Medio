            "state": "translated",
            "value": "Záznam síťové aktivity je vypnutý. Zapněte ho před zopakováním problému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Interneterfassung ist aus. Vor dem Nachstellen des Problems einschalten."
