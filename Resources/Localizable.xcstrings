        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přenos od %@. Zahrnuje odeslaná a přijatá HTTP data; nezahrnuje mezipaměť ani režii připojení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzung seit %@. Enthält gesendete und empfangene HTTP-Daten; ohne Cache-Antworten und Verbindungs-Overhead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation depuis %@. Inclut les données HTTP envoyées et reçues ; exclut les réponses en cache et la surcharge de connexion."
          }
        }
      }
    },
