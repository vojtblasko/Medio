    "Review the data before sharing it. For the best chance of fixing an issue, sharing all relevant categories is recommended.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the data before sharing it. For the best chance of fixing an issue, sharing all relevant categories is recommended."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před sdílením si data zkontrolujte. Pro snazší opravu problému doporučujeme přiložit všechny související kategorie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten vor dem Teilen prüfen. Alle relevanten Kategorien beizufügen erleichtert die Fehlerbehebung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les données avant de les partager. Inclure toutes les catégories pertinentes facilite la résolution du problème."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледайте данните, преди да ги споделите. За по-лесно отстраняване на проблема включете всички свързани категории."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred zdieľaním skontrolujte údaje. Na vyriešenie problému odporúčame priložiť všetky súvisiace kategórie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les données avant de les partager. Inclure toutes les catégories pertinentes facilite la résolution du problème."
          }
        }
      }
    },
