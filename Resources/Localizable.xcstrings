    "This file cannot be shared. Use an unprotected MP3, M4A, AAC, WAV, AIFF, or FLAC audio file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be shared. Use an unprotected MP3, M4A, AAC, WAV, AIFF, or FLAC audio file."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor nelze sdílet. Použijte nechráněný zvukový soubor MP3, M4A, AAC, WAV, AIFF nebo FLAC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann nicht geteilt werden. Eine ungeschützte Audiodatei im Format MP3, M4A, AAC, WAV, AIFF oder FLAC verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne peut pas être partagé. Utilisez un fichier audio MP3, M4A, AAC, WAV, AIFF ou FLAC non protégé."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този файл не може да бъде споделен. Използвайте незащитен аудио файл MP3, M4A, AAC, WAV, AIFF или FLAC."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento súbor sa nedá zdieľať. Použite nechránený zvukový súbor MP3, M4A, AAC, WAV, AIFF alebo FLAC."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne peut pas être partagé. Utilisez un fichier audio MP3, M4A, AAC, WAV, AIFF ou FLAC non protégé."
          }
        }
      }
    },
