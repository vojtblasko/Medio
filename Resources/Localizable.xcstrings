    "Open the address below in Safari on another device on the same Wi-Fi, enter the code, and tap Listen. Connect that device to your headphones or speaker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the address below in Safari on another device on the same Wi-Fi, enter the code, and tap Listen. Connect that device to your headphones or speaker."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete adresu níže v Safari na jiném zařízení ve stejné Wi-Fi, zadejte kód a klepněte na Poslouchat. K tomuto zařízení připojte sluchátka nebo reproduktor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse unten in Safari auf einem anderen Gerät im selben WLAN öffnen, den Code eingeben und auf Anhören tippen. Kopfhörer oder Lautsprecher mit diesem Gerät verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’adresse ci-dessous dans Safari sur un autre appareil connecté au même Wi-Fi, saisissez le code et touchez Écouter. Connectez votre casque ou enceinte à cet appareil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете адреса по-долу в Safari на друго устройство в същата Wi-Fi мрежа, въведете кода и натиснете Слушане. Свържете устройството със слушалките или тонколоната си."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte adresu nižšie v Safari na inom zariadení v rovnakej Wi-Fi, zadajte kód a klepnite na Počúvať. K zariadeniu pripojte slúchadlá alebo reproduktor."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’adresse ci-dessous dans Safari sur un autre appareil connecté au même Wi-Fi, saisissez le code et touchez Écouter. Connectez vos écouteurs ou votre haut-parleur à cet appareil."
          }
        }
      }
    },
    "Opens a new GitHub issue. You can copy diagnostics above and include them in your report.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a new GitHub issue. You can copy diagnostics above and include them in your report."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře nové hlášení na GitHubu. Diagnostiku výše můžete zkopírovat a přiložit k hlášení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen neuen GitHub-Fehlerbericht. Die Diagnose oben kann kopiert und dem Bericht beigefügt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un nouveau ticket GitHub. Vous pouvez copier le diagnostic ci-dessus et l’inclure dans votre rapport."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отваря нов сигнал в GitHub. Можете да копирате диагностиката по-горе и да я включите в отчета си."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí nové hlásenie v GitHube. Diagnostiku vyššie môžete skopírovať a priložiť k hláseniu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un nouveau ticket GitHub. Vous pouvez copier le diagnostic ci-dessus et l’inclure dans votre rapport."
          }
        }
      }
