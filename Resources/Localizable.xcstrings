    "Verify that the downloaded certificate matches the SHA-256 fingerprint shown on this host before trusting it. The certificate download is public; audio is available only through HTTPS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the downloaded certificate matches the SHA-256 fingerprint shown on this host before trusting it. The certificate download is public; audio is available only through HTTPS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než certifikátu udělíte důvěru, ověřte, že jeho otisk SHA-256 odpovídá otisku zobrazenému na tomto hostiteli. Stažení certifikátu je veřejné; zvuk je dostupný pouze přes HTTPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe vor dem Vertrauen, ob das geladene Zertifikat dem auf diesem Host angezeigten SHA-256-Fingerabdruck entspricht. Der Zertifikatdownload ist öffentlich; Audio ist nur über HTTPS verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de lui faire confiance, vérifiez que le certificat téléchargé correspond à l’empreinte SHA-256 affichée sur cet hôte. Le téléchargement du certificat est public ; l’audio est disponible uniquement via HTTPS."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да се доверите на сертификата, проверете дали SHA-256 отпечатъкът му съвпада с показания на този хост. Сертификатът е публичен; аудиото е достъпно само през HTTPS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred udelením dôvery overte, že stiahnutý certifikát zodpovedá odtlačku SHA-256 na tomto hostiteľovi. Certifikát je verejne dostupný; zvuk je dostupný iba cez HTTPS."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de lui faire confiance, vérifiez que le certificat téléchargé correspond à l’empreinte SHA-256 affichée sur cet hôte. Le téléchargement du certificat est public ; l’audio est disponible uniquement via HTTPS."
          }
        }
      }
    },
