    "Share Audio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share Audio"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení zvuku"
          }
        },
        "de": {
