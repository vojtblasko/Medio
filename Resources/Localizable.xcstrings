    "Favorites appears with normal folders after you favorite a song.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites appears with normal folders after you favorite a song."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po označení skladby jako oblíbené se Oblíbené zobrazí mezi běžnými složkami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten erscheinen zwischen den normalen Ordnern, sobald du einen Titel favorisierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris apparaissent parmi les dossiers dès que vous ajoutez un morceau aux favoris."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Любими се появява сред обикновените папки, след като харесате песен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po označení skladby ako obľúbenej sa Obľúbené zobrazia medzi bežnými priečinkami."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris apparaissent parmi les dossiers dès que vous ajoutez une chanson aux favoris."
          }
        }
      }
    },
    "Favorites is an in-app shadow folder. It links to the original songs without moving them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites is an in-app shadow folder. It links to the original songs without moving them."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblíbené jsou virtuální složkou aplikace. Odkazují na původní skladby, aniž by je přesouvaly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten sind ein virtueller Ordner in der App. Er verknüpft die Originaltitel, ohne sie zu verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris forment un dossier virtuel dans l’app. Il renvoie aux morceaux d’origine sans les déplacer."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Любими е виртуална папка в приложението. Тя сочи към оригиналните песни, без да ги премества."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obľúbené sú virtuálny priečinok v aplikácii. Odkazujú na pôvodné skladby bez ich presúvania."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris forment un dossier virtuel dans l’app. Il renvoie aux chansons d’origine sans les déplacer."
          }
        }
      }
    },
