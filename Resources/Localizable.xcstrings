    "Creates a temporary 96 kbps AAC copy. Videos share only their audio. Preparing a copy may take time; original files are unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a temporary 96 kbps AAC copy. Videos share only their audio. Preparing a copy may take time; original files are unchanged."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoří dočasnou kopii AAC s datovým tokem 96 kb/s. U videí sdílí pouze zvuk. Příprava může chvíli trvat; původní soubory se nemění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine temporäre AAC-Kopie mit 96 kbit/s. Bei Videos wird nur der Ton geteilt. Die Vorbereitung kann dauern; Originaldateien bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une copie AAC temporaire à 96 kbit/s. Seul le son des vidéos est partagé. La préparation peut prendre du temps ; les fichiers originaux restent inchangés."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създава временно AAC копие с 96 kbps. От видеата се споделя само звукът. Подготовката може да отнеме време; оригиналите остават непроменени."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorí dočasnú kópiu AAC s tokom 96 kbps. Z videí sa zdieľa iba zvuk. Príprava môže chvíľu trvať; pôvodné súbory sa nemenia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une copie AAC temporaire à 96 kbit/s. Seul le son des vidéos est partagé. La préparation peut prendre du temps ; les fichiers originaux restent inchangés."
          }
        }
      }
    },
