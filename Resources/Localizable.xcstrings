    "Usage since %@. Includes sent and received HTTP data; excludes cached responses and connection overhead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage since %@. Includes sent and received HTTP data; excludes cached responses and connection overhead."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přenos od %@. Zahrnuje odeslaná a přijatá HTTP data; nezahrnuje mezipaměť ani režii připojení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzung seit %@. Enthält gesendete und empfangene HTTP-Daten; ohne Cache-Antworten und Verbindungs-Overhead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation depuis %@. Inclut les données HTTP envoyées et reçues ; exclut les réponses en cache et la surcharge de connexion."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използване от %@. Включва изпратените и получените HTTP данни; изключва кешираните отговори и служебния трафик."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotreba od %@. Zahŕňa odoslané a prijaté HTTP dáta; nezahŕňa odpovede z vyrovnávacej pamäte a réžiu pripojenia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation depuis %@. Inclut les données HTTP envoyées et reçues ; exclut les réponses en cache et la surcharge de connexion."
          }
        }
      }
    },
