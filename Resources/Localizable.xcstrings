        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Objekte können nicht in diesen Ordner verschoben werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments ne peuvent pas être déplacés dans ce dossier."
          }
        }
      }
    },
    "This file cannot be shared. Use an unprotected MP3, M4A, AAC, WAV, AIFF, or FLAC audio file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
