    "Medio ReCapped doesn’t send your data to any servers. All is stored locally on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio ReCapped doesn’t send your data to any servers. All is stored locally on this device."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio ReCapped neposílá data na žádné servery. Vše je uložené místně v tomto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio ReCapped sendet keine Daten an Server. Alles wird lokal auf diesem Gerät gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio ReCapped n’envoie vos données à aucun serveur. Tout est stocké localement sur cet appareil."
          }
        }
      }
    },
    "Medio will stop MusicBrainz and Wikimedia artist-picture lookups. Downloaded artist pictures to delete: %lld. Artist pages will use the default person icon until you enable internet access again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio will stop MusicBrainz and Wikimedia artist-picture lookups. Downloaded artist pictures to delete: %lld. Artist pages will use the default person icon until you enable internet access again."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio přestane vyhledávat obrázky interpretů ve službách MusicBrainz a Wikimedia. Počet stažených obrázků interpretů ke smazání: %lld. Stránky interpretů budou používat výchozí ikonu osoby, dokud znovu nepovolíte přístup k internetu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio beendet die Suche nach Interpretenbildern bei MusicBrainz und Wikimedia. Zu löschende heruntergeladene Bilder: %lld. Auf den Interpretenseiten wird das Standardsymbol angezeigt, bis du den Internetzugriff wieder aktivierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio arrêtera les recherches d’images d’artistes sur MusicBrainz et Wikimedia. Images téléchargées à supprimer : %lld. Les pages d’artistes utiliseront l’icône par défaut jusqu’à la réactivation de l’accès à Internet."
          }
        }
      }
    },
