    "Scan to open the encrypted player and fill in the access code. Then tap Listen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan to open the encrypted player and fill in the access code. Then tap Listen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenováním otevřete šifrovaný přehrávač a vyplníte přístupový kód. Poté klepněte na Poslouchat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen, um den verschlüsselten Player zu öffnen und den Zugangscode auszufüllen. Dann auf Anhören tippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez pour ouvrir le lecteur chiffré et renseigner le code d’accès. Touchez ensuite Écouter."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирайте, за да отворите шифрования плейър и попълните кода за достъп. След това натиснете Слушане."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenujte kód na otvorenie šifrovaného prehrávača a vyplnenie prístupového kódu. Potom klepnite na Počúvať."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour ouvrir le lecteur chiffré et renseigner le code d’accès. Touchez ensuite Écouter."
          }
        }
      }
    },
