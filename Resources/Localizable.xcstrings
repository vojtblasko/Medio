    "Speech detection uses Apple’s on-device sound classifier. No audio leaves this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech detection uses Apple’s on-device sound classifier. No audio leaves this device."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Detekce řeči používá klasifikátor zvuku Apple přímo v zařízení. Zvuk zařízení neopouští."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung verwendet Apples Klangklassifizierung auf dem Gerät. Kein Audio verlässt dieses Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection utilise le classificateur audio d’Apple sur l’appareil. Aucun audio ne quitte cet appareil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознаването на говор използва класификатора на Apple на устройството. Никакво аудио не напуска устройството."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávanie reči používa klasifikátor zvuku Apple priamo v zariadení. Žiadny zvuk zariadenie neopúšťa."
          }
        },
        "fr-CA": {
