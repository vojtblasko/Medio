        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le partage chiffré. Veuillez réessayer."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Шифрованата сесия за споделяне не можа да бъде създадена. Опитайте отново."
          }
        },
        "sk": {
