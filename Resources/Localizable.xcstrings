    "All collectors are off by default. Turning them off stops new collection but keeps existing entries visible until you clear them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All collectors are off by default. Turning them off stops new collection but keeps existing entries visible until you clear them."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veškerá diagnostika je ve výchozím stavu vypnutá. Vypnutím se zastaví nové záznamy; stávající zůstanou, dokud je nevymažete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Erfassungen sind standardmäßig aus. Das Ausschalten stoppt neue Aufzeichnungen; vorhandene Einträge bleiben bis zum Löschen sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les collectes sont désactivées par défaut. Les désactiver arrête les nouveaux enregistrements ; les entrées existantes restent visibles jusqu’à leur suppression."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички видове събиране на данни са изключени по подразбиране. Изключването спира събирането, но запазва съществуващите записи, докато не ги изчистите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky zbery údajov sú predvolene vypnuté. Vypnutie zastaví nový zber, ale existujúce záznamy zostanú viditeľné, kým ich nevymažete."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les collectes sont désactivées par défaut. Les désactiver arrête les nouveaux enregistrements ; les entrées existantes restent visibles jusqu’à leur suppression."
          }
        }
      }
    },
    "Analyzes music on this device for speech and vocals, then excludes files where neither is detected. Videos and files that cannot be analyzed remain in the list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzes music on this device for speech and vocals, then excludes files where neither is detected. Videos and files that cannot be analyzed remain in the list."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V zařízení vyhledá v hudbě řeč a zpěv a vyřadí soubory, kde nezjistí ani jedno. Videa a neanalyzovatelné soubory v seznamu zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Musik auf diesem Gerät auf Sprache und Gesang und schließt Dateien ohne beides aus. Videos und nicht analysierbare Dateien bleiben in der Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse la musique sur cet appareil pour détecter la parole et le chant, puis exclut les fichiers sans voix. Les vidéos et fichiers non analysables restent dans la liste."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализира музиката на това устройство за говор и вокали и изключва файловете, в които не са открити. Видеата и файловете, които не могат да бъдат анализирани, остават в списъка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzuje hudbu v tomto zariadení a vylúči súbory, v ktorých nezistí reč ani spev. Videá a súbory, ktoré sa nedajú analyzovať, zostanú v zozname."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse la musique sur cet appareil pour détecter la parole et le chant, puis exclut les fichiers sans voix. Les vidéos et fichiers non analysables restent dans la liste."
          }
        }
      }
    },
