    "Refreshes the saved library snapshot, clears stale cover-art misses, retries embedded artwork for every song, and organizes loose SRT/LRC/TXT lyrics so reopened sessions do not get stuck on unassigned files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshes the saved library snapshot, clears stale cover-art misses, retries embedded artwork for every song, and organizes loose SRT/LRC/TXT lyrics so reopened sessions do not get stuck on unassigned files."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví uložený snímek knihovny, znovu vyhledá chybějící vložené obaly všech skladeb a uspořádá nepřiřazené texty SRT/LRC/TXT, aby se správně načetly i při dalším spuštění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert den gespeicherten Mediatheksstand, sucht erneut nach eingebetteten Covern aller Titel und ordnet lose SRT/LRC/TXT-Liedtexte, damit sie beim nächsten Öffnen richtig zugeordnet sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualise l’instantané de la bibliothèque, recherche à nouveau les pochettes intégrées de chaque morceau et organise les paroles SRT/LRC/TXT non associées pour les prochaines sessions."
          }
        }
      }
    },
