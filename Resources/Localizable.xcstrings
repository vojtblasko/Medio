    "Hides or shows the generic Unknown Artist and Unknown Album buckets in Library and Search.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides or shows the generic Unknown Artist and Unknown Album buckets in Library and Search."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje nebo zobrazí skupiny Neznámý interpret a Neznámé album v knihovně a hledání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Gruppen „Unbekannter Interpret“ und „Unbekanntes Album“ in Mediathek und Suche ein oder aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque les groupes Artiste inconnu et Album inconnu dans la bibliothèque et la recherche."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрива или показва общите категории Непознат изпълнител и Непознат албум в Библиотека и Търсене."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje alebo zobrazí všeobecné kategórie Neznámy interpret a Neznámy album v knižnici a vyhľadávaní."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque les groupes Artiste inconnu et Album inconnu dans la bibliothèque et la recherche."
          }
        }
