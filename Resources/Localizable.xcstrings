    "On the listening device, scan this certificate QR code. Install the downloaded Medio Local Audio profile in Settings → General → VPN & Device Management.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the listening device, scan this certificate QR code. Install the downloaded Medio Local Audio profile in Settings → General → VPN & Device Management."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zařízení posluchače naskenujte tento QR kód certifikátu. Stažený profil Medio Local Audio nainstalujte v Nastavení → Obecné → VPN a správa zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Zertifikat-QR-Code auf dem Empfangsgerät. Installiere das geladene Profil Medio Local Audio unter Einstellungen → Allgemein → VPN und Geräteverwaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil récepteur, scannez ce QR code de certificat. Installez le profil Medio Local Audio téléchargé dans Réglages → Général → VPN et gestion de l’appareil."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На приемащото устройство сканирайте този QR код за сертификата. Инсталирайте изтегления профил Medio Local Audio в Настройки → Основни → VPN и управление на устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na prijímajúcom zariadení naskenujte tento QR kód certifikátu. Stiahnutý profil Medio Local Audio nainštalujte v Nastavenia → Všeobecné → VPN a správa zariadenia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil récepteur, scannez ce QR code de certificat. Installez le profil Medio Local Audio téléchargé dans Réglages → Général → VPN et gestion de l’appareil."
          }
        }
      }
    },
    "One-Time Setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
