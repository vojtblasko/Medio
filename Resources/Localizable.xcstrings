    "When pinned as Priority 1, Favorites appears there instead of in the folder list. Your favorite songs are kept when either switch is off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When pinned as Priority 1, Favorites appears there instead of in the folder list. Your favorite songs are kept when either switch is off."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při připnutí jako priorita 1 se Oblíbené zobrazí tam místo seznamu složek. Vypnutím kteréhokoli přepínače se oblíbené skladby nesmažou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Priorität 1 angeheftet erscheinen Favoriten dort statt in der Ordnerliste. Deine Favoriten bleiben beim Ausschalten beider Schalter erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglés en priorité 1, les favoris y apparaissent plutôt que dans la liste des dossiers. Vos favoris sont conservés si l’un des interrupteurs est désactivé."
          }
        }
      }
    },
