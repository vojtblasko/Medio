    "Uses your device language by default. English, Czech, German, and French are available in iOS app settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your device language by default. English, Czech, German, and French are available in iOS app settings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím stavu používá jazyk zařízení. V nastavení aplikace v iOS je dostupná angličtina, čeština, němčina a francouzština."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet standardmäßig die Gerätesprache. Englisch, Tschechisch, Deutsch und Französisch sind in den iOS-App-Einstellungen verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la langue de l’appareil par défaut. L’anglais, le tchèque, l’allemand et le français sont disponibles dans les réglages iOS de l’app."
          }
        }
      }
    },
