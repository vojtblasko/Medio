    "Favorites appears with normal folders after you favorite a song.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites appears with normal folders after you favorite a song."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po označení skladby jako oblíbené se Oblíbené zobrazí mezi běžnými složkami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten erscheinen zwischen den normalen Ordnern, sobald du einen Titel favorisierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris apparaissent parmi les dossiers dès que vous ajoutez un morceau aux favoris."
          }
        }
      }
    },
    "Favorites is an in-app shadow folder. It links to the original songs without moving them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites is an in-app shadow folder. It links to the original songs without moving them."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblíbené jsou virtuální složkou aplikace. Odkazují na původní skladby, aniž by je přesouvaly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten sind ein virtueller Ordner in der App. Er verknüpft die Originaltitel, ohne sie zu verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris forment un dossier virtuel dans l’app. Il renvoie aux morceaux d’origine sans les déplacer."
          }
        }
      }
    },
    "Favorites is hidden from Home. Increase Priority Folders to configure Priority 1 as a normal folder or image.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites is hidden from Home. Increase Priority Folders to configure Priority 1 as a normal folder or image."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblíbené jsou na úvodní stránce skryté. Zvyšte počet prioritních složek a nastavte prioritu 1 jako složku nebo obrázek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten sind auf Start ausgeblendet. Mehr Prioritätsordner aktivieren, um Priorität 1 als Ordner oder Bild einzurichten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris sont masqués dans Accueil. Augmentez le nombre de dossiers prioritaires pour définir la priorité 1 comme dossier ou image."
          }
        }
      }
    },
