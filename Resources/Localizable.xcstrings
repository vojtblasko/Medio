    },
    "Could not start sharing. Check Local Network access in iOS Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start sharing. Check Local Network access in iOS Settings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení nelze spustit. Zkontrolujte přístup k místní síti v Nastavení iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe konnte nicht gestartet werden. Zugriff auf das lokale Netzwerk in den iOS-Einstellungen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le partage. Vérifiez l’accès au réseau local dans les réglages iOS."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Споделянето не можа да стартира. Проверете достъпа до локалната мрежа в настройките на iOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľanie sa nepodarilo spustiť. Skontrolujte prístup k lokálnej sieti v nastaveniach iOS."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
